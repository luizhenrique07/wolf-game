{
  "expo": {
    "name": "Wolf Game",
    "slug": "wolf-game",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wolfgame",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "wolf.game",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080510"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080510",
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-font",
      "expo-image",
      "./plugins/withGradleJvmArgs.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e2904a9-00bf-49e6-9f18-35f5fe0d45aa"
      }
    }
  }
}
